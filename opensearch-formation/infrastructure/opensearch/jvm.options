## =============================================================================
## Options JVM pour OpenSearch — Kit de formation
## ATTENTION : Ces valeurs sont adaptées à la formation (mémoire limitée)
## En production, utiliser au moins 50% de la RAM disponible (max 32 Go)
## =============================================================================

## -----------------------------------------------------------------------------
## Mémoire Heap (tas JVM)
## Formation : 512m — Production : adapter selon la RAM disponible
## Règle d'or : Xms == Xmx pour éviter les redimensionnements dynamiques
## -----------------------------------------------------------------------------
-Xms512m
-Xmx512m

## -----------------------------------------------------------------------------
## Garbage Collector — G1GC (recommandé pour OpenSearch)
## -----------------------------------------------------------------------------
# Utilisation du Garbage Collector G1 (défaut depuis Java 9+)
-XX:+UseG1GC

# Pause maximale souhaitée pour le GC (en millisecondes)
-XX:MaxGCPauseMillis=200

# Taille minimale de la région G1 (adapté pour heap 512m)
-XX:G1HeapRegionSize=4m

# Initiation du GC G1 quand le heap est rempli à 75%
-XX:InitiatingHeapOccupancyPercent=75

# Activation des journaux GC détaillés (utile pour le débogage)
# -Xlog:gc*,gc+age=trace,safepoint:file=/usr/share/opensearch/logs/gc.log:utctime,pid,tags:filecount=32,filesize=64m

## -----------------------------------------------------------------------------
## Flags JVM standard OpenSearch
## -----------------------------------------------------------------------------

# Désactivation des assertions JVM (performances)
-da

# Activation de la spécification des erreurs de pointeur null (Java 14+)
-XX:+ShowCodeDetailsInExceptionMessages

# Activation du fichier de dump en cas d'OutOfMemoryError
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/usr/share/opensearch/logs/heapdump.hprof

# Répertoire des fichiers d'erreur JVM
-XX:ErrorFile=/usr/share/opensearch/logs/hs_err_pid%p.log

## -----------------------------------------------------------------------------
## Optimisations JIT (Just-In-Time compiler)
## -----------------------------------------------------------------------------

# Activation des optimisations de compilation JIT
-XX:+OptimizeStringConcat
-XX:+UseCompressedOops
-XX:+UseCompressedClassPointers

## -----------------------------------------------------------------------------
## Options de compatibilité et d'accès (Java 11+)
## -----------------------------------------------------------------------------

# Accès aux modules internes Java (requis par Lucene/OpenSearch)
-Djava.security.manager=allow
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.lang.annotation=ALL-UNNAMED
--add-opens=java.base/java.lang.invoke=ALL-UNNAMED
--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
--add-opens=java.base/java.math=ALL-UNNAMED
--add-opens=java.base/java.net=ALL-UNNAMED
--add-opens=java.base/java.nio=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
--add-opens=java.base/sun.nio.cs=ALL-UNNAMED
--add-opens=java.base/sun.security.ssl=ALL-UNNAMED
--add-opens=java.base/sun.security.util=ALL-UNNAMED
--add-opens=java.base/sun.security.x509=ALL-UNNAMED

## -----------------------------------------------------------------------------
## Paramètres système
## -----------------------------------------------------------------------------

# Désactivation de la résolution DNS inverse (améliore les performances réseau)
-Djava.net.preferIPv4Stack=false

# Utilisation de /dev/urandom pour la génération de nombres aléatoires (plus rapide)
-Djava.security.egd=file:/dev/./urandom

# Nom de l'application pour les outils de monitoring
-Dprocess.name=opensearch

## -----------------------------------------------------------------------------
## Options de débogage (désactivées par défaut)
## Décommenter pour activer le débogage à distance
## -----------------------------------------------------------------------------
# -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
